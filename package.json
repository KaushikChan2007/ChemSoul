{
  "name": "chemsoul",
  "private": true,
  "version": "1.0.0",
  "description": "An interactive chemistry learning app for engineering students built with React and Vite.",
  "type": "module",
  "homepage": "https://kaushikchan2007.github.io/ChemSoul",
  "scripts": {
    "dev": "vite",
    "backend": "tsx server.ts",
    "start": "concurrently --kill-others-on-fail \"npm run backend\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "deploy": "gh-pages -d dist",
    "postbuild": "node scripts/copy-404.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "gh-pages": "^5.0.0"
  }
}
